# Server-side Vercel environment variables. Never put real secrets in this file.
CONTACT_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
CONTACT_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TURNSTILE_SITE_KEY=REPLACE_WITH_PUBLIC_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_PRIVATE_SECRET_KEY
# Optional comma-separated exact origins for a development/preview deployment.
# Add these hostnames to the Turnstile widget as well.
CONTACT_ALLOWED_ORIGINS=
